	-- Inject ke INDEX (hanya jika belum ada)
	for rawKey, answer in pairs(ExternalDB) do
		local toks = tokenize(rawKey)
		local key = table.concat(toks, " ")
		if key ~= "" and not INDEX[key] then
			local f = { answer = answer }
			INDEX[key] = f
			KEYS[#KEYS + 1] = { key = key, fact = f }
		end
	end

	-- ==================== ENGINE INTERNALS ====================
	local function matchRule(tk)
		local present = {}
		for _, t in ipairs(tk) do present[t] = true end
		local best, bestN = nil, 0
		for _, r in ipairs(RULES) do
			local ok = true
			for _, set in ipairs(r.groups) do
				local hit = false
				for w in pairs(set) do
					if present[w] then hit = true; break end
				end
				if not hit then ok = false; break end
			end
			if ok and #r.groups > bestN then best, bestN = r, #r.groups end
		end
		if best then return evaluate(best) end
		return nil
	end

	local function ordIndex(t)
		local n, suf = t:match("^(%d+)(%a+)$")
		if n and (suf == "st" or suf == "nd" or suf == "rd" or suf == "th") then return tonumber(n) end
		return ORDINALS[t]
	end
	local function kindOf(t)
		local s = t:gsub("s$", "")
		if SEQUENCES[s] then return s end
	end

	local function matchSequence(tk, i, j)
		if j - i > 2 then return nil end
		local idx, kind, last
		for p = i, j do
			local t = tk[p]
			local o = ordIndex(t)
			if o then
				if idx or last then return nil end
				idx = o
			elseif LAST_WORDS[t] then
				if idx or last then return nil end
				last = true
			elseif kindOf(t) then
				if kind then return nil end
				kind = kindOf(t)
			elseif t ~= "created" then
				return nil
			end
		end
		if not kind or not (idx or last) then return nil end
		local list = SEQUENCES[kind]
		return idx and list[idx] or list[#list]
	end

	local function readRepeat(tk, p)
		local a, b = tk[p], tk[p + 1]
		if a == "twice" then return 2, 1 end
		if a == "thrice" then return 3, 1 end
		if b == "times" or b == "time" then
			local c = tonumber(a) or NUMBER_WORDS[a]
			if c and c >= 1 and c <= 10 then return c, 2 end
		end
		return 1, 0
	end

	local function tailRepeat(tk)
		local n = #tk
		local c, used = readRepeat(tk, n)
		if used > 0 then return c end
		local c2, u2 = readRepeat(tk, n - 1)
		if u2 == 2 then return c2 end
		return 1
	end

	local function lev(a, b, maxD)
		local la, lb = #a, #b
		if math.abs(la - lb) > maxD then return maxD + 1 end
		local prev, cur = {}, {}
		for j = 0, lb do prev[j] = j end
		for i = 1, la do
			cur[0] = i
			local rowMin = i
			for j = 1, lb do
				local v = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + ((a:byte(i) == b:byte(j)) and 0 or 1))
				cur[j] = v
				if v < rowMin then rowMin = v end
			end
			if rowMin > maxD then return maxD + 1 end
			prev, cur = cur, prev
		end
		return prev[lb]
	end

	local MAXSPAN = 6

	local MACHINE_RANKING = { "PHOENIX", "PLANTBROS" }

	local BRAINROT_WORDS = { brainrot = true, brainrots = true, secret = true, secrets = true }
	local MACHINE_WORDS  = { machine = true, machines = true, fuse = true }
	local DLC_WORDS      = { dlc = true, plush = true, plushie = true, plushies = true, merch = true, money = true, usd = true }
	local RANK_FILLER    = {
		the = true, a = true, my = true, best = true, top = true, highest = true,
		rarest = true, strongest = true, richest = true, number = true, no = true,
		rank = true, ranked = true, tier = true,
	}

	local function rankOf(t)
		local o = ordIndex(t)
		if o then return o end
		if t:match("^%d+$") then return tonumber(t) end
		return NUMBER_WORDS[t]
	end

	local function matchRanked(tk)
		local hasMachine, hasBlock = false, false
		for _, t in ipairs(tk) do
			if DLC_WORDS[t] then return nil end
			if MACHINE_WORDS[t] then hasMachine = true end
			if BLOCK_WORDS[t] then hasBlock = true end
		end

		for p, t in ipairs(tk) do
			if BRAINROT_WORDS[t] then
				local rank
				for q = p - 1, math.max(1, p - 4), -1 do
					local w = tk[q]
					rank = rankOf(w)
					if rank then break end
					if not RANK_FILLER[w] then break end
				end
				if not rank then
					local k = p + 1
					if tk[k] == "number" or tk[k] == "no" then k = k + 1 end
					local r = tk[k] and rankOf(tk[k])
					if r and tk[k + 1] ~= "time" and tk[k + 1] ~= "times" then rank = r end
				end
				if rank and rank <= 20 then
					if rank == 1 and not hasMachine and not hasBlock then return nil end
					local list = hasBlock and LUCKY_RANKING or MACHINE_RANKING
					return list[rank] or false
				end
			end
		end
		return nil
	end

	local function solveClause(text)
		local tk = tokenize(text)
		local n = #tk
		if n == 0 then return nil end

		local ranked = matchRanked(tk)
		if ranked == false then return nil end
		if ranked then return string.rep(ranked, tailRepeat(tk)) end

		local ruled = matchRule(tk)
		if ruled then return string.rep(ruled, tailRepeat(tk)) end

		local out, i = {}, 1
		while i <= n do
			local matched = false
			for j = math.min(n, i + MAXSPAN - 1), i, -1 do
				local f = INDEX[table.concat(tk, " ", i, j)]
				local ans = (f and evaluate(f)) or matchSequence(tk, i, j)
				if ans then
					local c, used = readRepeat(tk, j + 1)
					out[#out + 1] = string.rep(ans, c)
					i = j + 1 + used
					matched = true
					break
				end
			end
			if not matched then i = i + 1 end
		end
		if #out > 0 then return table.concat(out) end

		local c, used = readRepeat(tk, n)
		if used == 0 then
			local c2, u2 = readRepeat(tk, n - 1)
			if u2 == 2 then c, used = c2, 2 end
		end
		local core = {}
		for p = 1, n - used do core[p] = tk[p] end
		local q = table.concat(core, " ")
		if #q < 3 then return nil end

		local best, bestScore, second = nil, 0, 0
		for _, e in ipairs(KEYS) do
			local maxLen = math.max(#q, #e.key)
			local maxD = math.floor(maxLen * 0.25)
			local d = lev(q, e.key, maxD)
			if d <= maxD then
				local score = 1 - d / maxLen
				if score > bestScore then
					if best and best.fact ~= e.fact then second = bestScore end
					best, bestScore = e, score
				elseif best and e.fact ~= best.fact and score > second then
					second = score
				end
			end
		end
		if best and bestScore >= 0.8 and (bestScore - second) >= 0.05 then
			return string.rep(evaluate(best.fact), c)
		end
		return nil
	end

	local FIELD_WORDS = { month = true, months = true, day = true, days = true, year = true, years = true, date = true, week = true, weekday = true }
	local FRAG_FILLER = { ["of"] = true, ["the"] = true, ["and"] = true, ["when"] = true, ["was"] = true, ["is"] = true, ["what"] = true, ["a"] = true, ["in"] = true, ["which"] = true }
	local function isFragment(text)
		local hasField = false
		for _, t in ipairs(tokenize(text)) do
			if FIELD_WORDS[t] then hasField = true
			elseif not FRAG_FILLER[t] then return false end
		end
		return hasField
	end
	local function stripFields(text)
		local r = {}
		for _, t in ipairs(tokenize(text)) do
			if not FIELD_WORDS[t] then r[#r + 1] = t end
		end
		return table.concat(r, " ")
	end

	solveRiddle = function(raw)
		local text = tostring(raw or "")
		local clauses = {}
		for clause in (text .. "+"):gmatch("([^%+,;&|\n]*)[%+,;&|\n]") do
			if clause:find("%S") then clauses[#clauses + 1] = clause end
		end
		local frag = {}
		for i, c in ipairs(clauses) do frag[i] = isFragment(c) end

		local out = {}
		for i, clause in ipairs(clauses) do
			local a
			if frag[i] then
				local ctx
				for j = i + 1, #clauses do if not frag[j] then ctx = clauses[j] break end end
				if not ctx then
					for j = i - 1, 1, -1 do if not frag[j] then ctx = clauses[j] break end end
				end
				if ctx then
					a = solveClause(clause .. " " .. stripFields(ctx))
					if a == solveClause(ctx) then a = nil end
				end
			else
				a = solveClause(clause)
			end
			if a then out[#out + 1] = a end
		end
		if #out == 0 then return nil end
		local s = table.concat(out)
		s = s:upper():gsub("%s+", "")
		return s
	end
end

return solveRiddle
